# ---------------------------------------------------------------------------
# Set ONE of these. The provider is auto-detected; Anthropic wins if both are
# present. Force it with DOCTOR_LLM_PROVIDER=anthropic|openrouter.
#
# Neither is needed to REPLAY a run or to reproduce any committed number: every
# response is cached under a hash of exactly what was sent, and the cache is
# committed. A key is only needed to create new cache entries.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-v1-...
# DOCTOR_LLM_PROVIDER=openrouter

# Model pinning (RULE 3: determinism is a deliverable). These are CANONICAL
# names; src/doctor/llm.py maps them to each provider's slug, and the cache is
# keyed on the canonical name so a cache built through one provider replays for
# someone holding the other.
DOCTOR_MODEL_FAST=claude-haiku-4.5
DOCTOR_MODEL_REASONING=claude-sonnet-4.6

# USD->INR for the dashboard's run-cost line. Stated rather than baked in.
DOCTOR_USD_INR=88.0

DOCTOR_SEED=20260824

# --- optional: real email sending -------------------------------------------
# Off by default. The .eml download and the pre-filled Gmail compose window do
# the same job without a credential, so this is opt-in only. App-password SMTP
# rather than OAuth: an auth redirect is one more thing to fail on stage.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password

# ---------------------------------------------------------------------------
# EMAIL (optional). Leave unset and the app still works: it offers a .eml
# download and a pre-filled Gmail compose window, neither of which needs a
# credential. Set these only if you want the "Send via SMTP" button live.
#
# For Gmail, SMTP_PASSWORD must be a 16-character App Password, NOT your
# account password -- Google refuses the account password on SMTP whenever
# 2-Step Verification is on. Generate one at:
#     myaccount.google.com/apppasswords
# Paste it without the spaces Google shows it in.
#
# Restart the API after editing this file, then press "Test credentials" on
# the run page to confirm before you need it.
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
