# Base URL of the separate VERITAS backend. Copy to .env to use it.
# Leave empty (or omit the file) to run on the labelled demo fixtures.
#
# NOT a secret. VITE_* values are compiled into the client bundle, so never
# put a credential here.
#
# Use 127.0.0.1, not localhost: this app server-renders, Node resolves
# localhost to ::1 first, and the API binds 127.0.0.1 only -- so "localhost"
# works in the browser and fails during SSR, surfacing as a blank error page
# that names no cause.
VITE_API_BASE_URL=http://127.0.0.1:8000
